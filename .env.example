# Push Lab Pessoal - exemplos seguros
# Nunca coloque secrets reais no bundle do frontend.

########################################
# Frontend publico - apps/web/.env.local
########################################
VITE_API_BASE_URL=/api
VITE_VAPID_PUBLIC_KEY=BPUBLIC_KEY_EXEMPLO_GERADA_PELO_WEB_PUSH
VITE_APP_URL=https://push-lab.exemplo.com
VITE_APP_VERSION=0.1.0

########################################
# Netlify Functions - variaveis privadas
########################################
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole_a_service_role_key_apenas_na_netlify
VAPID_PUBLIC_KEY=BPUBLIC_KEY_EXEMPLO_GERADA_PELO_WEB_PUSH
VAPID_PRIVATE_KEY=PRIVATE_KEY_EXEMPLO_NUNCA_VERSIONAR
VAPID_SUBJECT=mailto:voce@example.com
ALLOWED_ORIGIN=https://push-lab.exemplo.com
INTERNAL_CRON_SECRET=troque-por-um-segredo-longo-e-aleatorio
APP_URL=https://push-lab.exemplo.com
APP_VERSION=0.1.0
